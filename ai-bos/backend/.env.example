# App
ENVIRONMENT=development
DEBUG=True

# Security — generate with: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_random_secret

# Database
DATABASE_URL=postgresql://aibos:aibos_password@postgres:5432/aibos_db

# Vector DB (Local Docker or Qdrant Cloud)
# For local Docker:
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# For Qdrant Cloud (leave empty if running local Docker):
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=aibos_documents

# AI
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# CORS (Comma-separated list or JSON array of allowed frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
